# Arquivo de exemplo para variáveis de ambiente locais
# Copie este arquivo para .env e preencha com suas chaves reais.
# NUNCA envie o arquivo .env para o GitHub!

# Provedores de LLM
OPENROUTER_API_KEY=sua_chave_do_openrouter_aqui
OPENAI_API_KEY=sua_chave_da_openai_aqui
ANTHROPIC_API_KEY=sua_chave_da_anthropic_aqui

# Banco de Dados Vetorial no Supabase (Parte 2: RAG)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_anonima_publica_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui
